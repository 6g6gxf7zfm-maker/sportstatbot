# Sports API Keys (optional - many APIs are free)
# Get free API key from: https://the-odds-api.com/
ODDS_API_KEY=your_api_key_here

# Slack Webhook (optional - for automated posting)
SLACK_WEBHOOK_URL=your_webhook_url_here

# Report Settings
REPORT_TIMEZONE=America/New_York

# Email Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
NOTIFICATION_EMAILS=recipient1@example.com,recipient2@example.com

# Google Docs Integration
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_PARENT_FOLDER_ID=

# Environment (staging or production)
ENVIRONMENT=production

# Automation Settings
AUTO_CLEANUP_ENABLED=true
AUTO_CLEANUP_DAYS=30
AUTO_VERSIONING_ENABLED=true
DATA_FRESHNESS_CHECK_INTERVAL=300

# Dashboard Settings
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_DEBUG=false
