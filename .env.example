# Sports API Keys (optional - many APIs are free)
# Get free API key from: https://the-odds-api.com/
ODDS_API_KEY=your_api_key_here

# Slack Webhook (optional - for automated posting)
SLACK_WEBHOOK_URL=your_webhook_url_here

# Report Settings
REPORT_TIMEZONE=America/New_York

# Document Management (Google Docs/Drive)
# Download OAuth 2.0 credentials from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.pickle
GOOGLE_DOCS_ROOT_FOLDER=SportStatBot Reports

# Apple Notes Settings
APPLE_NOTES_STORAGE_DIR=./apple_notes_data

# Document Automation
AUTO_ARCHIVE_DAYS=30
ENABLE_AUTO_SUMMARY=true
DEFAULT_AUTHOR=SportStatBot EIC
OFFLINE_CACHE_DAYS=30
