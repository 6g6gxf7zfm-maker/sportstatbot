# Database Configuration
DATABASE_URL=postgresql+asyncpg://sportstat:sportstat123@db:5432/sportstatbot
DATABASE_URL_SYNC=postgresql://sportstat:sportstat123@db:5432/sportstatbot

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=SportStatBot
DEBUG=True
ENVIRONMENT=development

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs (Add your API keys)
ESPN_API_KEY=
SPORTSRADAR_API_KEY=
WEATHER_API_KEY=

# Analytics Configuration
ENABLE_LIVE_INGESTION=True
MOMENTUM_WINDOW_SECONDS=300
FORM_TRAJECTORY_GAMES=5
SIMILARITY_CLUSTER_COUNT=10

# Performance
CACHE_TTL_SECONDS=300
MAX_WORKERS=4
