// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id          String   @id @default(cuid())
  type        String   // 'digest', 'feature', 'report'
  league      String   // 'NFL', 'NBA', 'MLB', etc.
  status      String   // 'pending', 'running', 'completed', 'failed'
  result      String?  // JSON result data
  error       String?
  triggeredBy String   // email of user who triggered
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Export {
  id          String   @id @default(cuid())
  type        String   // 'google_docs', 'apple_notes'
  title       String
  league      String
  storyType   String   // 'digest', 'feature', 'report'
  exportedBy  String   // email of user who exported
  externalUrl String?  // URL to Google Doc or Apple Note
  metadata    String?  // JSON metadata
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // 'login', 'export', 'job_trigger', etc.
  details   String?  // JSON details
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}
